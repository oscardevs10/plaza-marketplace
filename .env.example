# Copia este archivo como .env.local (desarrollo) o configura las variables en tu hosting (producción).
# Sin ninguna variable, la app corre en local con base embebida, pagos Sandbox y correos capturados.

# --- Sitio ---
NEXT_PUBLIC_APP_NAME=Plaza
NEXT_PUBLIC_APP_URL=http://localhost:3005          # en producción: https://tudominio.com (obligatorio para webhooks y correos)

# --- Base de datos ---
# DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require   # Neon / Supabase / Railway. Sin ella se usa PGlite en .data/pglite
# DATABASE_POOL_SIZE=10

# --- Imágenes ---
# UPLOAD_DIR=.data/uploads                         # disco persistente; para serverless agrega un driver S3/R2 (ver docs/ARQUITECTURA.md)

# --- Pagos ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...                  # webhook: https://tudominio.com/api/webhooks/stripe
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRET=...                            # webhook: https://tudominio.com/api/webhooks/mercadopago
# ENABLE_SANDBOX_PAYMENTS=false                    # en producción el Sandbox está apagado salvo que lo actives
# SANDBOX_SECRET=una-cadena-larga-aleatoria        # obligatorio si activas el Sandbox en producción

# --- Correo: Gmail (gratis, envía a cualquier correo) ---
# Requiere verificación en dos pasos en Google y una "contraseña de aplicación": https://myaccount.google.com/apppasswords
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# (opcional) SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  EMAIL_FROM="Plaza <tucorreo@gmail.com>"

# --- Correo: Resend (requiere dominio propio para enviar a cualquiera) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=Plaza <pedidos@tudominio.com>

# --- Tareas programadas ---
# CRON_SECRET=una-cadena-larga-aleatoria           # GET /api/cron/expirar-pedidos con "Authorization: Bearer <CRON_SECRET>"
